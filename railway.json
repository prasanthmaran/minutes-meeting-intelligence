{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd frontend && npm ci && npm run build && cd ../backend && python -m pip install uv && python -m uv sync --frozen"
  },
  "deploy": {
    "startCommand": "cd backend && .venv/bin/python -m app.migrate && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips '*'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
