# demo = local lexical retrieval and verbatim excerpts (no LLM)
# openai = semantic retrieval and generated, cited answers
AI_MODE=demo
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Local backend only. Docker Compose supplies its own PostgreSQL URL.
# Local SQLite file (default). For Supabase, use the Session pooler URI from
# Project → Connect (port 5432, IPv4), with your database password:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Then run `make migrate` once. Copy existing SQLite meetings with:
#   cd backend && uv run python -m app.copy_data sqlite:///./meeting.db
DATABASE_URL=sqlite:///./meeting.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Or use Claude with local BM25 retrieval (no embedding API needed):
# AI_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional voice questions and spoken answers
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
