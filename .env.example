# demo = local lexical retrieval and verbatim excerpts (no LLM)
# openai = semantic retrieval and generated, cited answers
AI_MODE=demo
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Local backend only. Docker Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./meeting.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
